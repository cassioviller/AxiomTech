modules = ["python-3.12", "web"]
run = "python3 -m http.server 5000 --bind 0.0.0.0 --directory portfolio/site"
hidden = [".config", ".git", "axiom"]

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "static"
publicDir = "portfolio/site"

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Site do portfólio"

[[workflows.workflow]]
name = "Site do portfólio"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 -m http.server 5000 --bind 0.0.0.0 --directory portfolio/site"
waitForPort = 5000
